<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <ImageView
        android:id="@+id/resultImageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvDebug"
        app:layout_constraintVertical_weight="1"/>

    <com.example.yolodetectorapp.BoxOverlayView
        android:id="@+id/resultBoxOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/resultImageView"
        app:layout_constraintBottom_toBottomOf="@id/resultImageView"
        app:layout_constraintStart_toStartOf="@id/resultImageView"
        app:layout_constraintEnd_toEndOf="@id/resultImageView"/>

    <TextView
        android:id="@+id/tvVehicleName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="6dp"
        android:textSize="@dimen/text_debug"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#CC000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvDebug"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:textSize="@dimen/text_debug"
        android:textColor="#CCCCCC"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/resultImageView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnMatch"/>

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_ok_nok"
        android:textStyle="bold"
        android:visibility="gone"
        android:alpha="0.85"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnMatch"
        android:layout_width="0dp"
        android:layout_height="@dimen/btn_height"
        android:text="Görüntü Eşleştir"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/btn_text_size"
        android:backgroundTint="#E53935"
        android:layout_marginStart="@dimen/btn_margin_side"
        android:layout_marginEnd="@dimen/btn_margin_side"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/btnTable"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnTable"
        android:layout_width="0dp"
        android:layout_height="@dimen/btn_height"
        android:text="Tespit Tablosu"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/btn_text_size"
        android:backgroundTint="#FF2C2C"
        android:visibility="gone"
        android:layout_marginStart="@dimen/btn_margin_side"
        android:layout_marginEnd="@dimen/btn_margin_side"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@id/btnRetake"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnRetake"
        android:layout_width="0dp"
        android:layout_height="@dimen/btn_height"
        android:text="Tekrar Fotoğraf Çek"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/btn_text_size"
        android:backgroundTint="#FF2C2C"
        android:visibility="gone"
        android:layout_marginStart="@dimen/btn_margin_side"
        android:layout_marginEnd="@dimen/btn_margin_side"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>