<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter"/>

    <com.example.yolodetectorapp.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <View
        android:id="@+id/roiView"
        android:layout_width="@dimen/roi_width"
        android:layout_height="@dimen/roi_height"
        android:layout_gravity="center" />

    <!-- Araç seçimi EN ÜSTTE -->
    <Spinner
        android:id="@+id/vehicleSpinner"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="top"
        android:background="#AA000000"
        android:padding="8dp"
        android:popupBackground="#222222"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="120dp"
        android:text="Sigorta kutusunu ilgili bölgeye yaklaştırınız"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/text_instruction"
        android:background="#88000000"
        android:padding="10dp"/>

    <TextView
        android:id="@+id/tvOrientationWarning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="160dp"
        android:text="Lütfen kamerayı dik tutunuz"
        android:textColor="#FF1744"
        android:textSize="@dimen/text_instruction"
        android:padding="10dp"
        android:visibility="gone"/>

    <ImageButton
        android:id="@+id/btnFlash"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_flash_off"
        android:background="#66000000"
        android:padding="10dp"
        android:contentDescription="Flash"
        android:scaleType="fitCenter"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="@dimen/btn_margin_side"
        android:layout_marginEnd="@dimen/btn_margin_side">

        <!-- Parlaklık: tek ikon solda, seekbar sağda, ikona basınca seekbar açılır -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/btnBrightnessToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:alpha="0.5"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"/>

            <SeekBar
                android:id="@+id/brightnessSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="50"
                android:progressTint="#FFFFFF"
                android:thumbTint="#FFFFFF"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- Zoom: ikon solda, seekbar sağda, her zaman görünür -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍"
                android:textSize="18sp"
                android:layout_marginEnd="8dp"/>

            <SeekBar
                android:id="@+id/zoomSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:progressTint="#FFFFFF"
                android:thumbTint="#FFFFFF"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnCapture"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:backgroundTint="#FF0000"
            android:textColor="#FFFFFF"
            android:text="Fotoğraf Çek"
            android:textSize="@dimen/btn_text_size"/>

    </LinearLayout>

</FrameLayout>